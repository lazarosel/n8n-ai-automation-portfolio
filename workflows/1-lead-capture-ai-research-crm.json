      "id": "97b14826-8cd5-4eed-bf6e-af5f6d81eefc",
      "name": "Fetch company website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        912,
        -208
      ],
      "alwaysOutputData": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Turn the raw HTML of the lead's company website into clean text the AI can read\nconst cp = (n) => { try { return String.fromCodePoint(n); } catch (e) { return ' '; } };\nconst decode = (s) => s\n  .replace(/&#x([0-9a-f]+);/gi, (_, h) => cp(parseInt(h, 16)))\n  .replace(/&#(\\d+);/g, (_, d) => cp(Number(d)))\n  .replace(/&nbsp;/gi, ' ').replace(/&quot;/gi, '\"').replace(/&apos;/gi, \"'\")\n  .replace(/&lt;/gi, '<').replace(/&gt;/gi, '>').replace(/&amp;/gi, '&')\n  .replace(/&[a-z]+;/gi, ' ');\nconst clean = (s) => decode(s || '').replace(/\\s+/g, ' ').trim();\n\nreturn $input.all().map((item, i) => {\n  const lead = $('Clean & format lead').itemMatching(i).json;\n  const html = typeof item.json.html === 'string' ? item.json.html : '';\n\n  const title = (html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i) || [])[1];\n  // <meta name=\"description\" content=\"...\"> in any attribute order, with ' or \" quotes\n  const metaTag = (html.match(/<meta\\b[^>]*(?:name|property)\\s*=\\s*[\"'](?:og:)?description[\"'][^>]*>/i) || [''])[0];\n  const m = metaTag.match(/content\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)')/i) || [];\n  const description = m[1] || m[2] || '';\n\n  const text = clean(html\n    .replace(/<!--[\\s\\S]*?-->/g, ' ')\n    .replace(/<(script|style|noscript|svg|head|nav|footer|select|template)\\b[\\s\\S]*?<\\/\\1>/gi, ' ')\n    .replace(/<[^>]+>/g, ' '));\n\n  return {\n    json: {\n      ...lead,\n      website_url: 'https://' + lead.domain,\n      website_title: clean(title),\n      website_description: clean(description),\n      website_text: text.slice(0, 3000),\n    },\n    pairedItem: { item: i },\n  };\n});"
      },
      "id": "58470058-3015-40ae-8c49-1cf64aac7ff1",
      "name": "Extract website text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -208
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=LEAD\nName: {{ $json.full_name }}\nEmail: {{ $json.email }}\nCompany (as typed in the form): {{ $json.company }}\nBudget: {{ $json.budget }}\nMessage: {{ $json.message }}\n\nCOMPANY WEBSITE ({{ $json.website_url || 'not checked: personal email address' }})\nTitle: {{ $json.website_title || '-' }}\nDescription: {{ $json.website_description || '-' }}\nPage text: {{ $json.website_text || '-' }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a sales research assistant at an automation agency (we build n8n / AI automations for clients). A new prospective client just filled in our contact form. Write a short research brief for our sales team.\n\nRules:\n- Use ONLY the lead details and the website text provided. Never invent facts about the company.\n- company_size: only if the website text states it, or the lead's message makes it obvious (e.g. 'I run a small shop' = 1-10). Never estimate from how famous a brand is. Otherwise 'Unknown'.\n- If the website text is missing or doesn't describe a business, use 'Unknown' for company_name (unless the lead typed one), industry and what_they_do.\n- lead_intent: what they want US to build for them.\n- suggested_next_step: one concrete action for OUR sales rep to win this project (e.g. book a discovery call, send a relevant case study, propose a fixed-price pilot).\n- fit_score: 5 = clear automation need + budget $5k or more + real business; 1 = vague, tiny budget or unclear intent.\n- Keep every text field to one short sentence."
            }
          ]
        },
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 1500
        }
      },
      "id": "79707ac3-f472-4150-945d-108b3a6893b9",
      "name": "AI lead research",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        1360,
        -96
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"company_name\": {\n      \"type\": \"string\",\n      \"description\": \"Company name, or 'Unknown'\"\n    },\n    \"industry\": {\n      \"type\": \"string\",\n      \"description\": \"Short industry label, e.g. 'Logistics', 'E-commerce', or 'Unknown'\"\n    },\n    \"what_they_do\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence on what the company does, or 'Unknown'\"\n    },\n    \"company_size\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"1-10\",\n        \"11-50\",\n        \"51-200\",\n        \"201-1000\",\n        \"1000+\",\n        \"Unknown\"\n      ],\n      \"description\": \"Number of EMPLOYEES (not customers or users). Only if the website states the team size or the message makes it obvious; otherwise 'Unknown'.\"\n    },\n    \"lead_intent\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence: what the lead wants from us\"\n    },\n    \"fit_score\": {\n      \"type\": \"integer\",\n      \"description\": \"1 (poor fit) to 5 (ideal client), based on budget, intent and company\"\n    },\n    \"suggested_next_step\": {\n      \"type\": \"string\",\n      \"description\": \"One concrete next step for the sales rep\"\n    }\n  },\n  \"required\": [\n    \"company_name\",\n    \"industry\",\n    \"what_they_do\",\n    \"company_size\",\n    \"lead_intent\",\n    \"fit_score\",\n    \"suggested_next_step\"\n  ]\n}"
      },
